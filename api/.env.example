APP_NAME=sprintOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.sprintos.app

LOG_CHANNEL=stack
LOG_LEVEL=info

# ── Database (Aurora MySQL in production) ─────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sprintos
DB_USERNAME=sprintos
DB_PASSWORD=

# ── Queues (SQS + Horizon) ────────────────────────────────────────────────
QUEUE_CONNECTION=sqs
SQS_PREFIX=
SQS_QUEUE=default
CACHE_STORE=database
SESSION_DRIVER=database

# ── AI: Claude via Amazon Bedrock (Sprint IAM — no customer keys) ──────────
# AI_DRIVER=bedrock is the default. 'fake' is for local/CI only and is blocked
# in production. Credentials come from the IAM role (leave keys empty on AWS).
AI_DRIVER=bedrock
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BEDROCK_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model tiers (optional overrides):
# AI_MODEL_FAST=anthropic.claude-3-5-haiku-20241022-v1:0
# AI_MODEL_BALANCED=anthropic.claude-3-5-sonnet-20241022-v2:0
# AI_MODEL_POWERFUL=anthropic.claude-3-7-sonnet-20250219-v1:0
# AI_DEFAULT_TIER=balanced
# AI_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ── Billing (markup + Stripe) ─────────────────────────────────────────────
BILLING_DEFAULT_MARKUP=0.30
BILLING_CURRENCY=AUD
BILLING_CYCLE=monthly
# PAYMENTS_DRIVER=stripe is the default. 'fake' is local/CI only (blocked in prod).
PAYMENTS_DRIVER=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Build tooling (MCP) ───────────────────────────────────────────────────
GITHUB_TOKEN=
SPRINTOS_DEV_MYSQL_DSN=
