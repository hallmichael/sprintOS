includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Orchestration is Phase 5 scaffolding (intentionally references types not yet
    # built — RunStep, GuardChain, RunContext, etc.). Re-include when Phase 5 lands.
    excludePaths:
        - app/Modules/Orchestration/Domain/Loop/*
        - app/Modules/Orchestration/Domain/Run/*
        - app/Modules/Orchestration/Domain/Contracts/*
        - app/Modules/Orchestration/Services/*

    level: 6

    ignoreErrors:
        # Stylistic array/generic shape annotations — not correctness issues.
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: missingType.parameter
        - identifier: missingType.return

        # Larastan can't see Socialite's concrete provider methods (with/stateless/setConfig)
        # behind the Provider contract — they exist at runtime.
        - identifier: method.notFound
          path: app/Modules/Identity/Http/Controllers/SsoController.php

        # currentAccessToken() may return a TransientToken (tests) — the instanceof
        # guard is genuinely needed despite Larastan's narrowed type.
        - identifier: instanceof.alwaysTrue
          path: app/Modules/Identity/Http/Controllers/AuthController.php

    reportUnmatchedIgnoredErrors: false
